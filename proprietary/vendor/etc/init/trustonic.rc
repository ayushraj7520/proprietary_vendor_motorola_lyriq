# Start Daemon (Registry directories should already be present)
# Only list drivers that exist in /vendor/app/mcRegistry via -r flags.
# Factory-only drivers (030b/SPI, 020b/cmdq, video codecs, etc.) live on the
# tzapp partition and are auto-discovered by the daemon from /mnt/vendor/tzapp.
# Qwen's trustlet_restore script copies them from /data/vendor/mcRegistry to
# tzapp on post-fs-data (takes effect on next boot).
service mobicore /vendor/bin/mcDriverDaemon --P1 /mnt/vendor/persist/mcRegistry \
	-r /vendor/app/mcRegistry/06090000000000000000000000000000.drbin \
	-r /vendor/app/mcRegistry/020f0000000000000000000000000000.drbin \
	-r /vendor/app/mcRegistry/05120000000000000000000000000001.drbin \
	-r /vendor/app/mcRegistry/05070000000000000000000000000000.drbin \
	-r /vendor/app/mcRegistry/031c0000000000000000000000000000.drbin \
	-r /vendor/app/mcRegistry/40188311faf343488db888ad39496f9a.drbin \
	-r /vendor/app/mcRegistry/9073f03a9618383bb1856eb3f990babd.drbin \
	-r /vendor/app/mcRegistry/6b3f5fa0f8cf55a7be2582587d62d63a.drbin \
	-r /vendor/app/mcRegistry/5020170115e016302017012521300000.drbin \
	-r /vendor/app/mcRegistry/07210000000000000000000000000000.drbin
    user system
    group system
    class main
    priority -20

# t-Drv naming (drivers loaded via -r from vendor image):
# 020f : utils          05120001 : sec          05070 : goodix_fp
# 031c : (TEE)          40188311 : widevine     90733 : m4u
# 6b3f5 : hdcp          50201701 : drm_hdcp     06090 : keyinstall
# 07210 : (TEE)
#
# Factory-only (auto-discovered from /mnt/vendor/tzapp):
# 030b : spi (fingerprint)  020b : cmdq  030c : spi5
# 07060 : H264Vdec  07070 : H264Venc  08070 : VP9Vdec
# 4be4f : H265Vdec  0516 : (TEE)  090b : IRIS_I2C  etc.
